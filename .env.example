# ============================================================
# SocialDetective / FaceTrace — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Search Provider (SerpAPI) ---
# Optional: Get your key at: https://serpapi.com/manage-api-key
# If omitted, FaceTrace falls back to free Headless Google Lens + Direct Yandex.
SERPAPI_KEY=your_serpapi_api_key_here

# --- Blockchain (Ethereum Sepolia Testnet) ---
# RPC endpoint (Infura, Alchemy, or free public node)
# Free public option: RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Wallet private key (NEVER share or commit this)
# Needs a small amount of Sepolia ETH for gas (faucets: Google Web3 Faucet, sepoliafaucet.com)
PRIVATE_KEY=your_wallet_private_key_here

# Deployed ContentRegistry contract address
# (Set after running: python scripts/deploy_contract.py)
CONTRACT_ADDRESS=0x_deployed_contract_address_here

# --- Tor / Anonymity Routing ---
# Enable Tor SOCKS5 routing to avoid IP rate-limiting and bans on scrapers
USE_TOR=false
TOR_PROXY_URL=socks5://127.0.0.1:9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=

# --- Identity Pivot & Username Sweep (WhatsMyName) ---
PIVOT_ENABLED=true
PIVOT_MAX_SITES=300
PIVOT_TIMEOUT=8.0
PIVOT_SWEEP_TIMEOUT=120.0
PIVOT_MAX_WORKERS=12
PIVOT_MAX_ACCOUNTS=25
PIVOT_MAX_CANDIDATES=50

# --- Headless Search & Biometrics ---
LENS_HEADLESS=true
LENS_TIMEOUT=25.0
# Force CPU face inference even when a CUDA GPU is available: auto | cpu
FACE_DEVICE=auto
# Explicit path to Chrome/Chromium for the Headless Lens fallback (auto-detected if unset)
# CHROMIUM_PATH=/usr/bin/chromium
